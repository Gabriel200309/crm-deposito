// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// FASE 1 — Autenticação, usuários, papéis e permissões (RBAC) e auditoria.
// Demais entidades (clientes, produtos, pedidos, etc.) entram nas fases
// seguintes, conforme o roadmap.
// ---------------------------------------------------------------------------

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  CANCEL
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // perfis padrão do sistema (não podem ser excluídos)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      String // ex: "clientes", "estoque", "pedidos", "financeiro", "fiscal"
  action      PermissionAction
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role              Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs         AuditLog[]
  activitiesCreated Activity[]
  leadsResponsible  Lead[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // ex: "user.create", "user.update", "user.deactivate"
  entityType String // ex: "User", "Role"
  entityId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// FASE 2 — CRM: clientes, contatos, atividades/histórico e leads (funil de
// vendas). "Vendedor" ainda não é uma entidade própria (chega na Fase 5,
// Comercial) — por enquanto o responsável por um cliente/lead é um User.
// ---------------------------------------------------------------------------

enum CustomerType {
  PF
  PJ
}

enum CustomerClassification {
  CONSUMIDOR_FINAL
  PROFISSIONAL_CONSTRUCAO
  PEDREIRO
  ELETRICISTA
  ENCANADOR
  PINTOR
  EMPREITEIRO
  CONSTRUTORA
  CONDOMINIO
  EMPRESA
  REVENDEDOR
  CLIENTE_RECORRENTE
  CLIENTE_VIP
}

model Customer {
  id   String       @id @default(cuid())
  type CustomerType

  // Pessoa física
  fullName  String?
  cpf       String?
  rg        String?
  birthDate DateTime?

  // Pessoa jurídica
  companyName     String? // razão social
  tradeName       String? // nome fantasia
  cnpj            String?
  stateTaxId      String? // inscrição estadual
  municipalTaxId  String? // inscrição municipal
  responsibleName String? // responsável (contato principal na PJ)

  phone    String?
  whatsapp String?
  email    String?

  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  classifications CustomerClassification[]
  notes           String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   CustomerContact[]
  activities Activity[]
  leads      Lead[]

  @@unique([cpf])
  @@unique([cnpj])
  @@index([fullName])
  @@index([companyName])
  @@map("customers")
}

model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  role       String? // cargo
  phone      String?
  whatsapp   String?
  email      String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

enum ActivityType {
  LIGACAO
  WHATSAPP
  EMAIL
  VISITA
  REUNIAO
  NOTA
}

model Activity {
  id          String       @id @default(cuid())
  customerId  String?
  leadId      String?
  type        ActivityType
  description String
  dueDate     DateTime?
  completedAt DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([leadId])
  @@map("activities")
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEFONE
  SITE
  INDICACAO
  LOJA_FISICA
  VENDEDOR
  CAMPANHA
  OUTROS
}

enum LeadStage {
  NOVO_LEAD
  PRIMEIRO_CONTATO
  QUALIFICACAO
  ORCAMENTO_SOLICITADO
  ORCAMENTO_ENVIADO
  NEGOCIACAO
  AGUARDANDO_PAGAMENTO
  PEDIDO_CRIADO
  VENDA_REALIZADA
  PERDIDO
}

model Lead {
  id           String  @id @default(cuid())
  title        String
  customerId   String?
  contactName  String?
  contactPhone String?
  contactEmail String?

  responsibleId String?
  source        LeadSource @default(OUTROS)
  stage         LeadStage  @default(NOVO_LEAD)

  estimatedValue    Decimal?  @db.Decimal(12, 2)
  probability       Int? // 0-100
  expectedCloseDate DateTime?
  notes             String?
  lostReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  responsible User?      @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@index([customerId])
  @@index([responsibleId])
  @@index([stage])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// FASE 3 — Produtos: catálogo (produtos, categorias, marcas, unidades de
// medida). O controle de estoque em si (entradas/saídas/ajustes) é a Fase 4;
// por isso `currentStock` existe no produto mas não é editável pelo
// catálogo — fica em 0 até o módulo de estoque escrever nele via
// movimentações.
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([parentId, name])
  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

// Conversão entre unidades (ex: 1 caixa = 10 unidades) varia por produto, não
// é uma propriedade fixa da unidade — por isso não é modelada aqui. Quando o
// módulo de Pedidos (Fase 5) precisar disso, o fator de conversão deve viver
// no produto (ex: `unitsPerPackage`), não na unidade em si.
model Unit {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("units")
}

// Códigos de origem da mercadoria (Tabela A do CST/ICMS).
enum ProductOrigin {
  ORIGEM_0
  ORIGEM_1
  ORIGEM_2
  ORIGEM_3
  ORIGEM_4
  ORIGEM_5
  ORIGEM_6
  ORIGEM_7
  ORIGEM_8
}

model Product {
  id           String  @id @default(cuid())
  internalCode String  @unique
  sku          String? @unique
  barcode      String? @unique
  name         String
  description  String?

  categoryId String
  brandId    String?
  unitId     String

  weight   Decimal? @db.Decimal(10, 3)
  lengthCm Decimal? @db.Decimal(10, 2)
  widthCm  Decimal? @db.Decimal(10, 2)
  heightCm Decimal? @db.Decimal(10, 2)

  costPrice  Decimal  @default(0) @db.Decimal(12, 2)
  salePrice  Decimal  @db.Decimal(12, 2)
  promoPrice Decimal? @db.Decimal(12, 2)

  currentStock      Decimal  @default(0) @db.Decimal(12, 3)
  minStock          Decimal? @db.Decimal(12, 3)
  maxStock          Decimal? @db.Decimal(12, 3)
  warehouseLocation String?
  supplierName      String?

  ncm      String?
  cest     String?
  cfop     String?
  cstCsosn String?
  origin   ProductOrigin @default(ORIGEM_0)
  icmsRate Decimal?      @db.Decimal(5, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@map("products")
}
