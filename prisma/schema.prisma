// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// FASE 1 — Autenticação, usuários, papéis e permissões (RBAC) e auditoria.
// Demais entidades (clientes, produtos, pedidos, etc.) entram nas fases
// seguintes, conforme o roadmap.
// ---------------------------------------------------------------------------

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  CANCEL
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // perfis padrão do sistema (não podem ser excluídos)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      String // ex: "clientes", "estoque", "pedidos", "financeiro", "fiscal"
  action      PermissionAction
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role              Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs         AuditLog[]
  activitiesCreated Activity[]
  leadsResponsible  Lead[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // ex: "user.create", "user.update", "user.deactivate"
  entityType String // ex: "User", "Role"
  entityId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// FASE 2 — CRM: clientes, contatos, atividades/histórico e leads (funil de
// vendas). "Vendedor" ainda não é uma entidade própria (chega na Fase 5,
// Comercial) — por enquanto o responsável por um cliente/lead é um User.
// ---------------------------------------------------------------------------

enum CustomerType {
  PF
  PJ
}

enum CustomerClassification {
  CONSUMIDOR_FINAL
  PROFISSIONAL_CONSTRUCAO
  PEDREIRO
  ELETRICISTA
  ENCANADOR
  PINTOR
  EMPREITEIRO
  CONSTRUTORA
  CONDOMINIO
  EMPRESA
  REVENDEDOR
  CLIENTE_RECORRENTE
  CLIENTE_VIP
}

model Customer {
  id   String       @id @default(cuid())
  type CustomerType

  // Pessoa física
  fullName  String?
  cpf       String?
  rg        String?
  birthDate DateTime?

  // Pessoa jurídica
  companyName     String? // razão social
  tradeName       String? // nome fantasia
  cnpj            String?
  stateTaxId      String? // inscrição estadual
  municipalTaxId  String? // inscrição municipal
  responsibleName String? // responsável (contato principal na PJ)

  phone    String?
  whatsapp String?
  email    String?

  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  classifications CustomerClassification[]
  notes           String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   CustomerContact[]
  activities Activity[]
  leads      Lead[]

  @@unique([cpf])
  @@unique([cnpj])
  @@index([fullName])
  @@index([companyName])
  @@map("customers")
}

model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  role       String? // cargo
  phone      String?
  whatsapp   String?
  email      String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

enum ActivityType {
  LIGACAO
  WHATSAPP
  EMAIL
  VISITA
  REUNIAO
  NOTA
}

model Activity {
  id          String       @id @default(cuid())
  customerId  String?
  leadId      String?
  type        ActivityType
  description String
  dueDate     DateTime?
  completedAt DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([leadId])
  @@map("activities")
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEFONE
  SITE
  INDICACAO
  LOJA_FISICA
  VENDEDOR
  CAMPANHA
  OUTROS
}

enum LeadStage {
  NOVO_LEAD
  PRIMEIRO_CONTATO
  QUALIFICACAO
  ORCAMENTO_SOLICITADO
  ORCAMENTO_ENVIADO
  NEGOCIACAO
  AGUARDANDO_PAGAMENTO
  PEDIDO_CRIADO
  VENDA_REALIZADA
  PERDIDO
}

model Lead {
  id           String  @id @default(cuid())
  title        String
  customerId   String?
  contactName  String?
  contactPhone String?
  contactEmail String?

  responsibleId String?
  source        LeadSource @default(OUTROS)
  stage         LeadStage  @default(NOVO_LEAD)

  estimatedValue    Decimal?  @db.Decimal(12, 2)
  probability       Int? // 0-100
  expectedCloseDate DateTime?
  notes             String?
  lostReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  responsible User?      @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@index([customerId])
  @@index([responsibleId])
  @@index([stage])
  @@map("leads")
}
