// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// FASE 1 — Autenticação, usuários, papéis e permissões (RBAC) e auditoria.
// Demais entidades (clientes, produtos, pedidos, etc.) entram nas fases
// seguintes, conforme o roadmap.
// ---------------------------------------------------------------------------

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  CANCEL
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // perfis padrão do sistema (não podem ser excluídos)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      String // ex: "clientes", "estoque", "pedidos", "financeiro", "fiscal"
  action      PermissionAction
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role                    Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs               AuditLog[]
  activitiesCreated       Activity[]
  leadsResponsible        Lead[]
  stockMovementsCreated   StockMovement[]
  salesperson             Salesperson?
  receivablePaymentsTaken ReceivablePayment[]
  payablesCreated         AccountsPayable[]
  driver                  Driver?

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // ex: "user.create", "user.update", "user.deactivate"
  entityType String // ex: "User", "Role"
  entityId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// FASE 2 — CRM: clientes, contatos, atividades/histórico e leads (funil de
// vendas). "Vendedor" ainda não é uma entidade própria (chega na Fase 5,
// Comercial) — por enquanto o responsável por um cliente/lead é um User.
// ---------------------------------------------------------------------------

enum CustomerType {
  PF
  PJ
}

enum CustomerClassification {
  CONSUMIDOR_FINAL
  PROFISSIONAL_CONSTRUCAO
  PEDREIRO
  ELETRICISTA
  ENCANADOR
  PINTOR
  EMPREITEIRO
  CONSTRUTORA
  CONDOMINIO
  EMPRESA
  REVENDEDOR
  CLIENTE_RECORRENTE
  CLIENTE_VIP
}

model Customer {
  id   String       @id @default(cuid())
  type CustomerType

  // Pessoa física
  fullName  String?
  cpf       String?
  rg        String?
  birthDate DateTime?

  // Pessoa jurídica
  companyName     String? // razão social
  tradeName       String? // nome fantasia
  cnpj            String?
  stateTaxId      String? // inscrição estadual
  municipalTaxId  String? // inscrição municipal
  responsibleName String? // responsável (contato principal na PJ)

  phone    String?
  whatsapp String?
  email    String?

  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  classifications CustomerClassification[]
  notes           String?

  creditLimit Decimal? @db.Decimal(12, 2) // limite de crédito para vendas a prazo (crediário)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts    CustomerContact[]
  activities  Activity[]
  leads       Lead[]
  orders      Order[]
  receivables AccountsReceivable[]

  @@unique([cpf])
  @@unique([cnpj])
  @@index([fullName])
  @@index([companyName])
  @@map("customers")
}

model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  role       String? // cargo
  phone      String?
  whatsapp   String?
  email      String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

enum ActivityType {
  LIGACAO
  WHATSAPP
  EMAIL
  VISITA
  REUNIAO
  NOTA
}

model Activity {
  id          String       @id @default(cuid())
  customerId  String?
  leadId      String?
  type        ActivityType
  description String
  dueDate     DateTime?
  completedAt DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([leadId])
  @@map("activities")
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEFONE
  SITE
  INDICACAO
  LOJA_FISICA
  VENDEDOR
  CAMPANHA
  OUTROS
}

enum LeadStage {
  NOVO_LEAD
  PRIMEIRO_CONTATO
  QUALIFICACAO
  ORCAMENTO_SOLICITADO
  ORCAMENTO_ENVIADO
  NEGOCIACAO
  AGUARDANDO_PAGAMENTO
  PEDIDO_CRIADO
  VENDA_REALIZADA
  PERDIDO
}

model Lead {
  id           String  @id @default(cuid())
  title        String
  customerId   String?
  contactName  String?
  contactPhone String?
  contactEmail String?

  responsibleId String?
  source        LeadSource @default(OUTROS)
  stage         LeadStage  @default(NOVO_LEAD)

  estimatedValue    Decimal?  @db.Decimal(12, 2)
  probability       Int? // 0-100
  expectedCloseDate DateTime?
  notes             String?
  lostReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  responsible User?      @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@index([customerId])
  @@index([responsibleId])
  @@index([stage])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// FASE 3 — Produtos: catálogo (produtos, categorias, marcas, unidades de
// medida). O controle de estoque em si (entradas/saídas/ajustes) é a Fase 4;
// por isso `currentStock` existe no produto mas não é editável pelo
// catálogo — fica em 0 até o módulo de estoque escrever nele via
// movimentações.
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([parentId, name])
  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

// Conversão entre unidades (ex: 1 caixa = 10 unidades) varia por produto, não
// é uma propriedade fixa da unidade — por isso não é modelada aqui. Quando o
// módulo de Pedidos (Fase 5) precisar disso, o fator de conversão deve viver
// no produto (ex: `unitsPerPackage`), não na unidade em si.
model Unit {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("units")
}

// Códigos de origem da mercadoria (Tabela A do CST/ICMS).
enum ProductOrigin {
  ORIGEM_0
  ORIGEM_1
  ORIGEM_2
  ORIGEM_3
  ORIGEM_4
  ORIGEM_5
  ORIGEM_6
  ORIGEM_7
  ORIGEM_8
}

model Product {
  id           String  @id @default(cuid())
  internalCode String  @unique
  sku          String? @unique
  barcode      String? @unique
  name         String
  description  String?

  categoryId String
  brandId    String?
  unitId     String

  weight   Decimal? @db.Decimal(10, 3)
  lengthCm Decimal? @db.Decimal(10, 2)
  widthCm  Decimal? @db.Decimal(10, 2)
  heightCm Decimal? @db.Decimal(10, 2)

  costPrice  Decimal  @default(0) @db.Decimal(12, 2)
  salePrice  Decimal  @db.Decimal(12, 2)
  promoPrice Decimal? @db.Decimal(12, 2)

  currentStock      Decimal  @default(0) @db.Decimal(12, 3)
  minStock          Decimal? @db.Decimal(12, 3)
  maxStock          Decimal? @db.Decimal(12, 3)
  warehouseLocation String?
  supplierName      String?

  ncm      String?
  cest     String?
  cfop     String?
  cstCsosn String?
  origin   ProductOrigin @default(ORIGEM_0)
  icmsRate Decimal?      @db.Decimal(5, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@map("products")
}

// ---------------------------------------------------------------------------
// FASE 4 — Estoque: entradas, saídas e demais movimentações, sempre em
// registros imutáveis (nunca se edita/exclui uma movimentação — um erro se
// corrige com uma movimentação de compensação). `Product.currentStock` só é
// alterado dentro da mesma transação que cria a movimentação correspondente.
// "Venda" e "devolução" como tipos de movimentação ficam para quando Pedidos
// (Fase 5) e Devoluções existirem e gerarem essas movimentações sozinhos.
// ---------------------------------------------------------------------------

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
  PERDA
  AVARIA
  TRANSFERENCIA
  VENDA
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3) // sempre positiva; a direção vem do `type`
  reason      String?
  document    String? // documento relacionado (nota fiscal, pedido de compra, etc.)
  createdById String?
  createdAt   DateTime          @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([type])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// FASE 5 — Comercial: vendedores, comissões, orçamentos e pedidos.
//
// "Orçamento" e "Pedido" são o MESMO registro (`Order`), diferenciados só pelo
// `status` — a própria seção 8 do escopo já lista "Orçamento" e "Aguardando
// aprovação" como estágios do pipeline do pedido. Isso satisfaz o requisito
// de "converter orçamento em pedido sem recadastrar produtos" trivialmente
// (é a mesma linha, só muda o status), evitando duplicar clientes/itens numa
// tabela `quotes` separada da `orders`.
//
// Comissão é gerada automaticamente quando o pedido chega a FATURADO, usando
// o percentual padrão do vendedor sobre o subtotal — comissão por
// produto/categoria (seção 11) fica para uma iteração futura.
//
// Baixa de estoque (movimentação tipo VENDA, um item por produto do pedido)
// também acontece automaticamente ao chegar em FATURADO.
// ---------------------------------------------------------------------------

model Salesperson {
  id             String   @id @default(cuid())
  userId         String   @unique
  cpf            String?
  phone          String?
  monthlyGoal    Decimal? @db.Decimal(12, 2)
  commissionRate Decimal  @default(0) @db.Decimal(5, 2) // percentual padrão, ex: 5.00 = 5%
  team           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  commissions Commission[]

  @@map("salespeople")
}

enum OrderStatus {
  RASCUNHO
  ORCAMENTO
  AGUARDANDO_APROVACAO
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_CONFIRMADO
  EM_SEPARACAO
  SEPARADO
  FATURADO
  EM_TRANSPORTE
  ENTREGUE
  CANCELADO
  PERDIDO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  CREDIARIO
  OUTROS
}

enum DeliveryType {
  RETIRADA
  ENTREGA
}

model Order {
  id            String      @id @default(cuid())
  number        Int         @default(autoincrement())
  customerId    String
  salespersonId String?
  status        OrderStatus @default(RASCUNHO)
  validUntil    DateTime? // validade do orçamento

  paymentMethod PaymentMethod @default(OUTROS)
  paymentTerms  String? // condição de pagamento, descrição livre (ex: "30/60/90")
  installments  Int           @default(1) // gera essa quantidade de parcelas em contas a receber ao faturar
  firstDueDate  DateTime? // vencimento da 1ª parcela; parcelas seguintes somam 30 dias cada

  deliveryType          DeliveryType @default(RETIRADA)
  deliveryAddressStreet String?
  deliveryAddressNumber String?
  deliveryAddressCity   String?
  deliveryAddressState  String?
  deliveryAddressZip    String?

  discount Decimal @default(0) @db.Decimal(12, 2) // desconto adicional sobre o pedido
  freight  Decimal @default(0) @db.Decimal(12, 2)

  notes        String?
  lostReason   String? // preenchido quando status = PERDIDO
  cancelReason String? // preenchido quando status = CANCELADO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesperson Salesperson?         @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  commissions Commission[]
  receivables AccountsReceivable[]
  delivery    Delivery?

  @@index([customerId])
  @@index([salespersonId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2) // preço no momento do pedido (não muda se o preço do produto mudar depois)
  discount  Decimal @default(0) @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum CommissionStatus {
  PENDENTE
  PAGA
}

model Commission {
  id            String           @id @default(cuid())
  orderId       String           @unique
  salespersonId String
  baseAmount    Decimal          @db.Decimal(12, 2)
  rate          Decimal          @db.Decimal(5, 2)
  amount        Decimal          @db.Decimal(12, 2)
  status        CommissionStatus @default(PENDENTE)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesperson Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  @@index([salespersonId])
  @@map("commissions")
}

// ---------------------------------------------------------------------------
// FASE 6 — Financeiro: contas a receber (geradas do pedido ao faturar, com
// parcelamento), contas a pagar (independente, sem módulo de compras formal)
// e limite de crédito do cliente.
//
// "Vencido"/"pago"/"parcialmente pago" NÃO são armazenados como estado — são
// calculados a partir de `dueDate` e da soma de `ReceivablePayment` (mesma
// lógica de não persistir dados derivados usada nos totais do pedido, Fase
// 5). Só `cancelled` é um estado real, porque não dá pra derivar isso de
// data/valor. Isso evita precisar de um job agendado só pra "vencer" contas.
// ---------------------------------------------------------------------------

model AccountsReceivable {
  id                String   @id @default(cuid())
  orderId           String
  customerId        String
  installmentNumber Int
  installmentsTotal Int
  dueDate           DateTime
  amount            Decimal  @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  cancelled     Boolean       @default(false)
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments ReceivablePayment[]

  @@index([customerId])
  @@index([orderId])
  @@index([dueDate])
  @@map("accounts_receivable")
}

model ReceivablePayment {
  id            String        @id @default(cuid())
  receivableId  String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paidAt        DateTime      @default(now())
  createdById   String?
  notes         String?

  receivable AccountsReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([receivableId])
  @@map("receivable_payments")
}

enum PayableStatus {
  ABERTO
  PAGO
  CANCELADO
}

model AccountsPayable {
  id            String        @id @default(cuid())
  description   String
  supplierName  String?
  dueDate       DateTime
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(OUTROS)
  status        PayableStatus @default(ABERTO)
  paidAt        DateTime?
  notes         String?
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([status])
  @@map("accounts_payable")
}

// ---------------------------------------------------------------------------
// FASE 7 — Entregas: agendamento e rastreio das entregas dos pedidos com
// `deliveryType = ENTREGA`. Pedidos com retirada na loja não passam por
// aqui — o próprio status do pedido (FATURADO -> ENTREGUE) já cobre esse
// caso, sem precisar de motorista/rota.
//
// Uma entrega é criada automaticamente (status AGENDADA) na mesma transação
// que fatura o pedido. A partir daí, avançar EM_TRANSPORTE/ENTREGUE no
// pedido passa a ser feito só por aqui (o seletor de status do pedido
// bloqueia essas duas transições quando há entrega), pra não ter dois
// lugares "donos" do mesmo estado.
// ---------------------------------------------------------------------------

model Driver {
  id           String   @id @default(cuid())
  userId       String   @unique
  phone        String?
  vehiclePlate String?
  vehicleModel String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@map("drivers")
}

enum DeliveryStatus {
  AGENDADA
  EM_ROTA
  ENTREGUE
  FALHOU
  CANCELADA
}

model Delivery {
  id            String         @id @default(cuid())
  orderId       String         @unique
  driverId      String?
  status        DeliveryStatus @default(AGENDADA)
  scheduledDate DateTime?
  startedAt     DateTime?
  deliveredAt   DateTime?
  recipientName String?
  failureReason String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([driverId])
  @@index([scheduledDate])
  @@map("deliveries")
}
